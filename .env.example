# Neon com pool para as requisições Vercel.
# postgres://usuario:senha@host-pooler/banco?sslmode=require
DATABASE_URL=

# Conexão direta para migrations, importação e administração via CLI.
DATABASE_URL_DIRECT=

# Os comandos PHP leem as variáveis exportadas no ambiente.
APP_ENV=development
APP_FULL_BASE_URL=http://127.0.0.1:8080
APP_DEFAULT_TIMEZONE=America/Sao_Paulo

# Defina uma chave aleatória de pelo menos 32 caracteres em produção.
SECURITY_SALT=
SESSION_SECURE=false
